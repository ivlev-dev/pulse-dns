; Example authoritative zone for pulsed (RFC 1035 master file).
$ORIGIN example.com.
$TTL 3600

@       IN  SOA ns1.example.com. hostmaster.example.com. (
                2026112402 ; serial
                7200       ; refresh
                900        ; retry
                1209600    ; expire
                300 )      ; negative TTL

@       IN  NS  ns1.example.com.
@       IN  NS  ns2.example.com.

ns1     IN  A     192.0.2.53
ns2     IN  AAAA  2001:db8::53

@       IN  A     192.0.2.10
@       IN  AAAA  2001:db8::10
@       IN  MX  10 mail.example.com.
@       IN  TXT "v=spf1 mx -all" "pulse-dns master file"

www     IN  A     192.0.2.20
mail    IN  A     192.0.2.30
alias   IN  CNAME www.example.com.

wild    IN  TXT "wildcard base"
*.wild  IN  A     192.0.2.99
