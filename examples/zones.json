{
  "listen_udp": "127.0.0.1:5353",
  "listen_tcp": "127.0.0.1:5353",
  "workers": 2,
  "log_level": "info",
  "tcp": {
    "max_connections": 1024,
    "idle_timeout_ms": 5000
  },
  "zones": [
    {
      "origin": "example.com.",
      "class": "IN",
      "default_ttl": 3600,
      "records": [
        {
          "name": "@",
          "type": "SOA",
          "ttl": 3600,
          "rdata": {
            "mname": "ns1.example.com.",
            "rname": "hostmaster.example.com.",
            "serial": 2026112401,
            "refresh": 7200,
            "retry": 900,
            "expire": 1209600,
            "minimum": 300
          }
        },
        { "name": "@", "type": "NS", "rdata": "ns1.example.com." },
        { "name": "@", "type": "NS", "rdata": "ns2.example.com." },
        { "name": "ns1", "type": "A", "ttl": 3600, "rdata": "192.0.2.53" },
        { "name": "ns2", "type": "AAAA", "ttl": 3600, "rdata": "2001:db8::53" },
        { "name": "@", "type": "A", "ttl": 300, "rdata": "192.0.2.10" },
        { "name": "@", "type": "AAAA", "ttl": 300, "rdata": "2001:db8::10" },
        {
          "name": "@",
          "type": "MX",
          "ttl": 600,
          "rdata": { "preference": 10, "exchange": "mail.example.com." }
        },
        {
          "name": "@",
          "type": "TXT",
          "ttl": 600,
          "rdata": ["v=spf1 mx -all", "pulse-dns mvp"]
        },
        {
          "name": "@",
          "type": "CAA",
          "ttl": 3600,
          "rdata": { "flags": 0, "tag": "issue", "value": "letsencrypt.org" }
        },
        { "name": "www", "type": "A", "ttl": 300, "rdata": "192.0.2.20" },
        { "name": "mail", "type": "A", "ttl": 300, "rdata": "192.0.2.30" },
        { "name": "alias", "type": "CNAME", "ttl": 120, "rdata": "www.example.com." },
        {
          "name": "_sip._tcp",
          "type": "SRV",
          "ttl": 300,
          "rdata": { "priority": 10, "weight": 5, "port": 5060, "target": "sip.example.com." }
        },
        { "name": "sip", "type": "A", "ttl": 300, "rdata": "192.0.2.70" },
        { "name": "wild", "type": "TXT", "ttl": 300, "rdata": ["wildcard base"] },
        { "name": "*.wild", "type": "A", "ttl": 300, "rdata": "192.0.2.99" }
      ]
    }
  ]
}
